# Rendered by the nginx image (envsubst) at startup.
server {
    listen 80;
    root /usr/share/nginx/html;

    add_header X-Frame-Options DENY always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header Cache-Control no-cache always;

    location = /config.json {
        default_type application/json;
        return 200 '{"keycloakUrl":"${KEYCLOAK_PUBLIC_URL}","realm":"capstone","clientId":"admin-portal"}';
    }

    # Group → clearance / agents table, shown read-only on the page
    location = /permissions.yaml {
        default_type text/plain;
        alias /srv/config/permissions.yaml;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
