# nginx 이미지가 시작할 때 envsubst로 환경 변수를 채워 넣습니다.
server {
    listen 80;
    root /usr/share/nginx/html;

    add_header X-Frame-Options DENY always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header Cache-Control no-cache always;

    location = /config.json {
        default_type application/json;
        return 200 '{"keycloakUrl":"${KEYCLOAK_PUBLIC_URL}","realm":"capstone","clientId":"admin-portal"}';
    }

    # 그룹 → 열람 등급 / Agent 표. 페이지에서 읽기 전용으로 표시
    location = /permissions.yaml {
        default_type text/plain;
        alias /srv/config/permissions.yaml;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
