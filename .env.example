# 복사 방법: python3 scripts/gen_env.py   (모든 __GENERATE__ 자리를 무작위 시크릿으로 채움)
# .env는 절대 커밋하지 마세요.

# 사용자 브라우저에서 보이는 주소. SSH 터널을 쓰는 동안에는 localhost입니다.
OPENWEBUI_PUBLIC_URL=http://localhost:3000
KEYCLOAK_PUBLIC_URL=http://localhost:8080
ADMIN_PORTAL_PUBLIC_URL=http://localhost:3001

POSTGRES_PASSWORD=__GENERATE__
KEYCLOAK_DB_PASSWORD=__GENERATE__
OPENWEBUI_DB_PASSWORD=__GENERATE__
APP_DB_PASSWORD=__GENERATE__

# Keycloak 관리 콘솔 (http://localhost:8080/admin)
KEYCLOAK_ADMIN_USER=kcadmin
KEYCLOAK_ADMIN_PASSWORD=__GENERATE__

# OIDC 클라이언트 시크릿 (최초 실행 시 Keycloak으로 import)
OPENWEBUI_OIDC_CLIENT_SECRET=__GENERATE__
GATEWAY_KC_CLIENT_SECRET=__GENERATE__

# 데모 계정 ceo / secretary / staff / sysadmin 공통 비밀번호
DEMO_USER_PASSWORD=__GENERATE_SHORT__

WEBUI_SECRET_KEY=__GENERATE__
# Open WebUI -> gateway: 연결용 API 키, 그리고 X-OpenWebUI-User-Jwt 서명용 시크릿
BACKEND_API_KEY=__GENERATE__
OWUI_FORWARD_JWT_SECRET=__GENERATE__

# Agent backend (agent-backend/) — Ollama Cloud LLM (https://ollama.com/settings/keys)
OLLAMA_API_KEY=
OLLAMA_MODEL=deepseek-v4.1-flash
# 다른 OpenAI 호환 LLM을 쓸 때: LLM_PROVIDER=openai + 아래 세 값
# (테스트용 claude-bridge: OPENAI_BASE_URL=http://claude-bridge:8080/v1, OPENAI_MODEL=sonnet,
#  OPENAI_API_KEY=CLAUDE_BRIDGE_API_KEY와 같은 값)
LLM_PROVIDER=ollama
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# Agent backend 회의 DB: DB agents의 kelec / grp 스키마를 각각 소유하는 역할
AGENTS_K_DB_PASSWORD=__GENERATE__
AGENTS_GROUP_DB_PASSWORD=__GENERATE__

# claude-bridge (테스트용 — Claude 구독으로 LLM 호출, 토큰은 `claude setup-token`으로 발급)
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_BRIDGE_API_KEY=__GENERATE__
CLAUDE_EFFORT=low

# speech-service (회의 녹음 STT + 화자 식별, 음성 등록 페이지 /voice/)
SPEECH_DB_PASSWORD=__GENERATE__
SPEECH_API_KEY=__GENERATE__
# Keycloak의 confidential client `voice-enroll` 시크릿 — realm import에 아직 없으므로 client를 직접 만들고 같은 값을 넣을 것
VOICE_OIDC_CLIENT_SECRET=__GENERATE__
VOICE_SESSION_SECRET=__GENERATE__
# voiceprint 암호화 키: 32바이트 base64 (openssl rand -base64 32). 잃어버리면 등록된 voiceprint를 복호화할 수 없음
VOICEPRINT_KEY=__GENERATE_KEY32__
# 있으면 Groq Whisper로 STT, 비우면 로컬 SenseVoice
GROQ_API_KEY=
